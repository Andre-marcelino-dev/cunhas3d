# =====================================================================
# .env de PRODUÇÃO — Cunhas 3D na Locaweb
# Renomeie este arquivo para ".env" (dentro da pasta cunhas3d-app/) e
# troque tudo que estiver entre < >.
# =====================================================================
APP_NAME="Cunhas 3D"
APP_ENV=production
APP_DEBUG=false
# Chave de segurança: o pacote já vem com uma nova. Não compartilhe e não troque depois que o site estiver no ar.
APP_KEY=<COLE_A_CHAVE_AQUI>
APP_URL=https://<SEU-DOMINIO.com.br>
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR
APP_TIMEZONE=America/Sao_Paulo

LOG_CHANNEL=daily
LOG_LEVEL=error

# ---------------------------------------------------------------------
# Banco MySQL criado no painel da Locaweb (Banco de Dados > MySQL)
# O host aparece no painel, algo como: xxxxxxx.mysql.dbaas.com.br
# ---------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=<HOST_DO_MYSQL_DA_LOCAWEB>
DB_PORT=3306
DB_DATABASE=<NOME_DO_BANCO>
DB_USERNAME=<USUARIO_DO_BANCO>
DB_PASSWORD=<SENHA_DO_BANCO>

SESSION_DRIVER=database
SESSION_LIFETIME=240
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=public

# Fotos e modelos 3D ficam direto na pasta pública do subdomínio (a hospedagem não cria o link storage)
PUBLIC_DISK_ROOT=../public_html/storage

# ---------------------------------------------------------------------
# E-mail (conta criada no painel da Locaweb, ex.: contato@seu-dominio)
# ---------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=email-ssl.com.br
MAIL_PORT=465
MAIL_USERNAME=<contato@SEU-DOMINIO.com.br>
MAIL_PASSWORD=<SENHA_DO_EMAIL>
MAIL_FROM_ADDRESS="<contato@SEU-DOMINIO.com.br>"
MAIL_FROM_NAME="${APP_NAME}"
# Quando o cliente clicar em "Responder", a resposta vai para o e-mail da empresa
MAIL_REPLY_TO_ADDRESS=cunhas3d@outlook.com

# ---------------------------------------------------------------------
# MERCADO PAGO — credenciais de PRODUÇÃO
# https://www.mercadopago.com.br/developers/panel/app
# ---------------------------------------------------------------------
MP_PUBLIC_KEY=<APP_USR-...>
MP_ACCESS_TOKEN=<APP_USR-...>
MP_WEBHOOK_SECRET=<ASSINATURA_SECRETA_DO_WEBHOOK>
MP_SANDBOX=false

# Frete
LOJA_FRETE_FIXO=24.90
LOJA_FRETE_GRATIS_ACIMA=299

# ---------------------------------------------------------------------
# Notificações do app (Web Push). Gere com: php artisan push:chaves
# A chave privada é secreta. Se trocar as chaves, os clientes precisam ativar as notificações de novo.
# ---------------------------------------------------------------------
VAPID_PUBLIC_KEY=<CHAVE_PUBLICA>
VAPID_PRIVATE_KEY=<CHAVE_PRIVADA>
