APP_NAME="Cunhas 3D"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR
APP_TIMEZONE=America/Sao_Paulo

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Banco MySQL (serviço "mysql" do docker-compose)
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=cunhas3d
DB_USERNAME=cunhas3d
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=240
CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=public

# E-mails: em desenvolvimento ficam gravados no log (storage/logs/laravel.log)
MAIL_MAILER=log
MAIL_FROM_ADDRESS="contato@cunhas3d.com.br"
MAIL_FROM_NAME="${APP_NAME}"

# ---------------------------------------------------------------
# MERCADO PAGO
# Pegue as credenciais em: https://www.mercadopago.com.br/developers/panel/app
# Use as credenciais de TESTE enquanto estiver desenvolvendo.
# ---------------------------------------------------------------
MP_PUBLIC_KEY=
MP_ACCESS_TOKEN=
# "Assinatura secreta" mostrada na tela de Webhooks da sua aplicação
MP_WEBHOOK_SECRET=
MP_SANDBOX=true

# Frete
LOJA_FRETE_FIXO=24.90
LOJA_FRETE_GRATIS_ACIMA=299
